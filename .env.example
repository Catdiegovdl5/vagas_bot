# Configurações do Servidor e IA - Vagas Bot SaaS
DEBUG=True
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# Segredo de Autenticação do Webhook de Pagamento
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# Bot Telegram e Notificações
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# Credenciais de E-mail (Gmail App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Provedores de Inteligência Artificial (BYOK / Pool)
GROQ_API_KEY_1=gsk_your_groq_key_1_here
GROQ_API_KEY_2=gsk_your_groq_key_2_here
GROQ_API_KEY_3=gsk_your_groq_key_3_here

GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
